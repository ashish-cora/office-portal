---
import { FOOTER_TOPICS } from '../../data/navigation';
---

<footer class="footer" aria-label="Site footer">
	<div class="footer-inner">
		<div class="footer-brand">
			<span class="brand-mark">M</span>
			<span class="brand-name">Meridian Office Portal</span>
			<p class="footer-tagline">Demo portal &mdash; simulated content, no real data.</p>
		</div>

		<nav class="footer-nav" aria-label="Footer navigation">
			{FOOTER_TOPICS.map((topic) => (
				<div class="footer-topic">
					<h3 class="footer-topic-title">{topic.label}</h3>
					<ul class="footer-topic-list">
						{topic.items.map((item) => (
							<li class="footer-topic-item">
								<a
									class={`footer-topic-link ${item.social ? 'footer-topic-link--social' : ''}`}
									href={item.href}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</nav>
	</div>

	<div class="footer-bottom">
		<p class="copyright">&copy; {new Date().getFullYear()} Meridian Corp. All rights reserved.</p>
		<p class="footer-disclaimer">
			This is a demonstration portal. No real employee data or credentials are used.
		</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 260px 1fr;
		gap: var(--space-4);
		padding: var(--space-4);
		max-width: 1200px;
		margin: 0 auto;
		align-items: start;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.brand-mark {
		width: 32px;
		height: 32px;
		border-radius: var(--radius);
		background: var(--color-primary);
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1rem;
		font-weight: 700;
	}

	.brand-name {
		color: var(--color-text);
		font-weight: 700;
		font-size: 1.125rem;
		white-space: nowrap;
	}

	.footer-tagline {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.footer-nav {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: var(--space-4);
		margin: 0;
	}

	.footer-topic {
		margin: 0;
	}

	.footer-topic-title {
		margin: 0 0 var(--space-2) 0;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--color-text);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.footer-topic-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.footer-topic-item {
		margin: 0;
	}

	.footer-topic-link {
		color: var(--color-text-muted);
		font-size: 0.9375rem;
	}

	.footer-topic-link:hover,
	.footer-topic-link:focus-visible {
		color: var(--color-primary);
		text-decoration: underline;
	}

	.footer-topic-link--social {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		color: var(--color-text);
		font-size: 0.875rem;
		font-weight: 500;
	}

	.footer-topic-link--social:hover,
	.footer-topic-link--social:focus-visible {
		border-color: var(--color-primary);
		color: var(--color-primary);
		background: var(--color-active-bg);
		text-decoration: none;
	}

	.footer-bottom {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-4);
		border-top: 1px solid var(--color-border);
		background: #f9fafb;
	}

	.copyright {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.footer-disclaimer {
		margin: 0;
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	@media (max-width: 768px) {
		.footer-inner {
			grid-template-columns: 1fr;
		}

		.footer-nav {
			grid-template-columns: 1fr;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
