---
import Layout from '../layouts/Layout.astro';
import ArtificialIntelligence from '../components/services/ArtificialIntelligence.astro';
import WebDevelopment from '../components/services/WebDevelopment.astro';
import ApplicationDevelopment from '../components/services/ApplicationDevelopment.astro';
import DataEngineering from '../components/services/DataEngineering.astro';
import HealthcareTechnology from '../components/services/HealthcareTechnology.astro';
---

<Layout>
	<section class="services-page" aria-labelledby="services-heading">
		<div class="services-inner">
			<div class="services-header">
				<h1 id="services-heading" class="services-title">Our Services</h1>
				<p class="services-subtitle">Technology solutions built for modern organizations.</p>
			</div>

			<div class="services-grid">
				<ArtificialIntelligence />
				<WebDevelopment />
				<ApplicationDevelopment />
				<DataEngineering />
				<HealthcareTechnology />
			</div>
		</div>
	</section>
</Layout>

<style>
	.services-page {
		background: var(--color-bg);
		padding: var(--space-6) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.services-inner {
		padding: 2rem var(--space-4);
		max-width: 1200px;
		margin: 0 auto;
	}

	.services-header {
		text-align: center;
		margin-bottom: var(--space-6);
	}

	.services-title {
		margin: 0 0 var(--space-2) 0;
		font-size: 2rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.services-subtitle {
		margin: 0;
		font-size: 1rem;
		color: var(--color-text-muted);
	}

	.services-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	@media (min-width: 768px) {
		.services-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.services-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
