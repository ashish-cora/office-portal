---
import Layout from '../../layouts/Layout.astro';
import { PortableText } from '@portabletext/astro';
import { getNewsOrFallback } from '../../lib/articles';

export async function getStaticPaths() {
	const articles = await getNewsOrFallback();
	return articles.map((article) => ({
		params: { slug: article.slug },
	}));
}

const { slug } = Astro.params;

const articles = await getNewsOrFallback();
const article = articles.find((a) => a.slug === slug);
---

<Layout>
	{article ? (
		<article class="news-article">
			<header class="news-article-header">
				<span class="news-article-category">{article.category}</span>
				<time class="news-article-date" datetime={article.date}>{article.date}</time>
				<h1 class="news-article-title">{article.title}</h1>
				<p class="news-article-author">By {article.author}</p>
			</header>
			<div class="news-article-content">
				<PortableText value={article.content} />
			</div>
			<a href="/news" class="news-article-back">&#8592; Back to all news</a>
		</article>
	) : (
		<section class="not-found">
			<h1>News article not found</h1>
			<p>The article you are looking for does not exist.</p>
			<a href="/news">Back to all news</a>
		</section>
	)}
</Layout>

<style>
	.news-article {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem var(--space-4);
		display: flex;
		flex-direction: column;
	}

	.news-article-header {
		margin-bottom: var(--space-6);
	}

	.news-article-category {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-primary);
		background: var(--color-active-bg);
		padding: 0.125rem var(--space-2);
		border-radius: var(--radius);
		display: inline-block;
		margin-bottom: var(--space-2);
	}

	.news-article-date {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		margin-bottom: var(--space-2);
		display: block;
	}

	.news-article-title {
		margin: 0 0 var(--space-3) 0;
		font-size: 2rem;
		font-weight: 700;
		color: var(--color-text);
		line-height: 1.3;
	}

	.news-article-author {
		margin: 0 0 var(--space-4) 0;
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		font-style: italic;
	}

	.news-article-content {
		font-size: 1rem;
		color: var(--color-text);
		line-height: 1.8;
		flex: 1;
	}

	.news-article-content p {
		margin: 0 0 var(--space-4) 0;
	}

	.news-article-back {
		display: inline-flex;
		align-items: center;
		color: var(--color-primary);
		font-weight: 500;
	}

	.news-article-back:hover {
		text-decoration: underline;
	}

	.not-found {
		text-align: center;
		padding: 4rem var(--space-4);
		max-width: 500px;
		margin: 0 auto;
	}

	@media (max-width: 640px) {
		.news-article-title {
			font-size: 1.5rem;
		}
	}
</style>